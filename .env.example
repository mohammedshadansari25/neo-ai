# Database & Broker
POSTGRES_USER=neo
POSTGRES_PASSWORD=neo_dev_password
POSTGRES_DB=neodb
DATABASE_ASYNC_URL=postgresql+asyncpg://neo:neo_dev_password@postgres:5432/neodb
DATABASE_SYNC_URL=postgresql+psycopg://neo:neo_dev_password@postgres:5432/neodb
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Security & Auth
JWT_SECRET_KEY=replace_with_at_least_32_random_characters_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# Storage & Upload Bounds
UPLOAD_DIR=/app/data/uploads
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=30

# AI Providers & Retrieval
PRIMARY_LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=gemini-2.5-flash
VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=sk-placeholder
GEMINI_API_KEY=placeholder
TAVILY_API_KEY=tvly-placeholder
DEDUP_SIMILARITY_THRESHOLD=0.92
CONFLICT_SIMILARITY_THRESHOLD=0.78
